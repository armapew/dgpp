# Single-GB10 NVIDIA Qwen profile; append to the existing site .env.
# Requires spark-2026.09.28.6 or later and its matching launcher.
DGPP_QSA_QUERY_TILE=2
DGPP_QSA_DECODE_QUERY_TILE=2
DGPP_QSA_DECODE_PARTS=8
# Extra device allocation, included in the startup memory plan.
DGPP_DENSE_CACHE_MIB=4096
# Grouping can change floating-point execution shapes and generated text.
DGPP_BATCH_PREFILL=1
DGPP_SKIP_PREFILL_OUTPUT=0
# Share identical cold prefixes across simultaneous requests.
DGPP_PREFIX_COALESCE=1
# Keep the QSA selection projection in original checkpoint BF16 precision.
DGPP_QSA_INDEXER_BF16=1
# Exact n-gram page advice and reusable prefill gather workers.
DGPP_NGRAM_STAGING=1
# Restrict only draft proposals; target verification keeps the full vocabulary.
# Set to 0 to restore the full draft head. Acceptance is workload-dependent.
DGPP_DRAFT_VOCAB_LIMIT=65536
# Background hints for future prompt records; no additional device allocation.
# Set to 0 to disable. Queue and host scratch are bounded by the window/slots.
DGPP_NGRAM_LOOKAHEAD_TOKENS=8192
